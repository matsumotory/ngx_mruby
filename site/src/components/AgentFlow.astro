---
import { Code } from '@astrojs/starlight/components';
import fs from 'node:fs';
import path from 'node:path';
const ja = Astro.props.lang === 'ja';
const source = fs.readFileSync(path.resolve(process.cwd(), '../examples/start/route.rb'), 'utf8');
// A verbatim, syntactically complete table from the runnable local handler.
// The full handler, validation and configuration remain in the walkthrough.
const mapping = source.slice(source.indexOf('  routes = {'), source.indexOf('\n  begin')).trimEnd();
const routes = ['a', 'b'].map(model => ({
  model,
  backend: `local_api_${model}`,
  credential: `Bearer local-upstream-${model}`,
  entry: mapping.split("\n").find(line => line.includes(`"mock-model-${model}"`)),
  output: JSON.stringify({ upstream: model, model: `mock-model-${model}`, credential_replaced: true }, null, 2).replaceAll('": ', '":'),
}));
for (const route of routes) {
  if (!mapping.includes(`"mock-model-${route.model}" => ["${route.backend}", "${route.credential}"]`)) {
    throw new Error('Update the homepage route from examples/start/route.rb');
  }
}
---
<figure class="v3-flow" data-route="a" aria-label={ja ? 'modelを使ったAPI振り分け。リクエスト、Rubyの規則、転送先と応答を示します。' : 'Model routing: a request, its Ruby rule, the selected upstream and response.'}>
  <div class="request-strip">
    <div><h3 class="flow-title">{ja ? 'アプリから送るリクエスト' : 'Request from your app'}</h3><code>POST /v1/responses</code></div>
    <div class="request-payload"><code>Authorization: Bearer local-client</code><code class="request-model">{`{"model":"mock-model-a"}`}</code></div>
  </div>
  <div class="route-controls" role="group" hidden aria-label={ja ? '送信するmodelを選ぶ' : 'Choose the requested model'}><button type="button" data-model="a" aria-pressed="true">{ja ? 'モデルA' : 'Model A'}</button><button type="button" data-model="b" aria-pressed="false">{ja ? 'モデルB' : 'Model B'}</button></div>
  <div class="routing-workspace">
    <div class="route-source">
      <h3 class="flow-title">{ja ? 'Rubyの振り分け規則' : 'Ruby routing rule'}</h3>
      {routes.map(route => <pre class="route-selection" data-rule={route.model} hidden={route.model !== 'a'}><code>{route.entry}</code></pre>)}
      <details class="route-source-all"><summary>{ja ? 'Rubyの対応表をすべて見る' : 'See the complete Ruby mapping'}</summary><Code code={mapping} lang="ruby" title="route.rb" /></details>
    </div>
    <div class="flow-providers">
      <h3 class="flow-title" data-upstream-title>{ja ? 'API Aへ転送' : 'Forward to API A'}</h3>
      {routes.map(route => <div class="provider-node" data-provider={route.model} hidden={route.model !== 'a'}><code>{route.backend}</code><code class="provider-credential">Authorization: {route.credential}</code></div>)}
      <div class="route-response" aria-live="polite" aria-atomic="true">
        {routes.map(route => <div class="route-result" data-response={route.model} hidden={route.model !== 'a'}><Code code={route.output} lang="json" title={ja ? '200 · mockの応答' : '200 · mock response'} /></div>)}
      </div>
    </div>
  </div>
  <figcaption>{ja ? '下の手順で動かすローカルmockの表示例です。ここでmodelを選んでも、ネットワークへリクエストは送りません。' : 'An illustration of the local mock you can run below. Selecting a model here does not send a network request.'}</figcaption>
</figure>
<script>
  for (const figure of document.querySelectorAll<HTMLElement>('.v3-flow')) {
    const controls = figure.querySelector<HTMLElement>('.route-controls');
    if (!controls) continue;
    controls.hidden = false;
    const ja = document.documentElement.lang === 'ja';
    const select = (model: 'a' | 'b', animate: boolean) => {
      figure.dataset.route = model;
      for (const button of controls.querySelectorAll<HTMLButtonElement>('button[data-model]')) button.setAttribute('aria-pressed', String(button.dataset.model === model));
      const request = figure.querySelector('.request-model');
      if (request) request.textContent = `{"model":"mock-model-${model}"}`;
      const upstreamTitle = figure.querySelector('[data-upstream-title]');
      if (upstreamTitle) upstreamTitle.textContent = ja ? `API ${model.toUpperCase()}へ転送` : `Forward to API ${model.toUpperCase()}`;
      for (const node of figure.querySelectorAll<HTMLElement>('[data-provider], [data-response], [data-rule]')) {
        const selected = (node.dataset.provider ?? node.dataset.response ?? node.dataset.rule) === model;
        node.hidden = !selected;
        node.classList.remove('route-pulse');
        if (animate && selected && node.dataset.provider) { void node.offsetWidth; node.classList.add('route-pulse'); }
      }
    };
    select('a', false);
    controls.addEventListener('click', event => {
      const target = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-model]');
      if (target?.dataset.model === 'a' || target?.dataset.model === 'b') select(target.dataset.model, true);
    });
  }
</script>
