---
import { Code } from 'astro-expressive-code/components';
import fs from 'node:fs';
import path from 'node:path';
const ja = Astro.props.lang === 'ja';
const source = fs.readFileSync(path.resolve(process.cwd(), '../examples/start/route.rb'), 'utf8');
// A verbatim, syntactically complete table from the runnable local handler.
// The full handler, validation and configuration remain in the walkthrough.
const mapping = source.slice(source.indexOf('  routes = {'), source.indexOf('\n  begin')).trimEnd();
const routes = ['a', 'b'].map(model => ({
  model,
  backend: `local_api_${model}`,
  credential: `Bearer local-upstream-${model}`,
  output: JSON.stringify({ upstream: model, model: `mock-model-${model}`, credential_replaced: true }, null, 2).replaceAll('": ', '":'),
}));
for (const route of routes) {
  if (!mapping.includes(`"mock-model-${route.model}" => ["${route.backend}", "${route.credential}"]`)) {
    throw new Error('Update the homepage route from examples/start/route.rb');
  }
}
---
<figure class="v3-flow" data-route="a" aria-label={ja ? 'アプリのリクエストをnginxとRubyで振り分け、APIの応答をアプリへ返す流れ' : 'Your app sends a request; nginx and Ruby route it; the API response returns to your app.'}>
  <figcaption>{ja ? '通信しない表示例です。同じmockを下の手順で実行できます。キーはすべてデモ用です。' : 'An illustration, not a live request. Run the same mock below. All keys shown are demonstration values.'}</figcaption>
  <div class="route-controls" role="group" hidden aria-label={ja ? '送信するmodelを選ぶ' : 'Choose the requested model'}><button type="button" data-model="a" aria-pressed="true">{ja ? 'モデルA' : 'Model A'}</button><button type="button" data-model="b" aria-pressed="false">{ja ? 'モデルB' : 'Model B'}</button></div>
  <ol class="routing-workspace">
    <li class="flow-step request-strip" data-step="request">
      <div class="flow-description"><h3 class="flow-title">{ja ? 'アプリから送る' : 'Send from your app'}</h3><p>{ja ? 'チャットや文書要約のアプリは、共通のプロキシURLへ送信します。modelを変えても、URLと利用者キーは共通です。' : 'Your chat or summarization app calls the proxy URL. Choose a different model without changing that URL or the client key.'}</p></div>
      <div class="request-payload"><code>POST http://localhost:8080<wbr />/v1/responses</code><code>Authorization: Bearer local-client</code><code class="request-model">{`{"model":"mock-model-a"}`}</code></div>
    </li>
    <li class="flow-step route-source" data-step="rule">
      <div class="flow-description"><h3 class="flow-title">{ja ? 'nginx内のRubyで選ぶ' : 'Choose in nginx with Ruby'}</h3><p>{ja ? '利用者キーを確認し、modelから転送先とそのAPI用のキーを選びます。対応表は各アプリではなく、プロキシ側で一か所にまとめます。' : 'Check the client key, then look up the destination and its API key by model. Keep this mapping at the proxy, not in each app.'}</p></div>
      <div class="route-source-all"><Code code={mapping} lang="ruby" title="route.rb" /></div>
    </li>
    <li class="flow-step flow-providers" data-step="response">
      <div class="flow-description"><h3 class="flow-title" data-upstream-title>{ja ? 'API Aの応答を返す' : "Relay API A's response"}</h3><p>{ja ? 'nginxがAPI用のキーで転送し、応答をアプリへ中継します。下のmockは転送先とキーの置換結果を返します。LLMの生成結果ではありません。' : 'nginx forwards with the API key and relays the response to your app. This mock reports the destination and credential replacement, not generated text.'}</p>
        {routes.map(route => <div class="provider-node" data-provider={route.model} hidden={route.model !== 'a'}><code>{route.backend}</code><code class="provider-credential">Authorization: {route.credential}</code></div>)}
      </div>
      <div class="route-response" aria-live="polite" aria-atomic="true">{routes.map(route => <div class="route-result" data-response={route.model} hidden={route.model !== 'a'}><Code code={route.output} lang="json" title={ja ? '200 · アプリに届く応答' : '200 · Response received by your app'} /></div>)}</div>
    </li>
  </ol>

</figure>
<script>
  for (const figure of document.querySelectorAll<HTMLElement>('.v3-flow')) {
    const controls = figure.querySelector<HTMLElement>('.route-controls');
    if (!controls) continue;
    controls.hidden = false;
    const ja = document.documentElement.lang === 'ja';
    const select = (model: 'a' | 'b', animate: boolean) => {
      figure.dataset.route = model;
      for (const button of controls.querySelectorAll<HTMLButtonElement>('button[data-model]')) button.setAttribute('aria-pressed', String(button.dataset.model === model));
      const request = figure.querySelector('.request-model');
      if (request) request.textContent = `{"model":"mock-model-${model}"}`;
      const upstreamTitle = figure.querySelector('[data-upstream-title]');
      if (upstreamTitle) upstreamTitle.textContent = ja ? `API ${model.toUpperCase()}の応答を返す` : `Relay API ${model.toUpperCase()}'s response`;
      for (const node of figure.querySelectorAll<HTMLElement>('[data-provider], [data-response]')) {
        const selected = (node.dataset.provider ?? node.dataset.response) === model;
        node.hidden = !selected;

      }
      for (const step of figure.querySelectorAll<HTMLElement>('.flow-step')) {
        step.classList.remove('route-pulse');
        if (animate) { void step.offsetWidth; step.classList.add('route-pulse'); }
      }
    };
    select('a', false);
    controls.addEventListener('click', event => {
      const target = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-model]');
      if (target?.dataset.model === 'a' || target?.dataset.model === 'b') select(target.dataset.model, true);
    });
  }
</script>
