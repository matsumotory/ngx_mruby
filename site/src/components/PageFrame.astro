---
import { getSiteRoute, routeLabel } from '../route.mjs';
// The page frame keeps a menu on every page (docs/proposals/site.md, 4.10).
// The pane holds the site links before the document sidebar. From 50em it
// becomes the persistent sidebar on document pages; on other pages it
// remains a menu until the header has room for the section links.
// The popover opens without JavaScript. The script switches the wide-screen
// sidebar out of popover mode and traps focus while the menu is open.
import Icon from './Icon.astro';
import SiteMenu from './SiteMenu.astro';
import { strings } from '../site-nav.mjs';

const { hasSidebar } = getSiteRoute(Astro.locals);
const t = strings(getSiteRoute(Astro.locals).locale);
const sidebarLabel = routeLabel(Astro.locals, 'sidebarNav.accessibleLabel');
---

<div class="page site-flex">
  <header class="header"><slot name="header" /></header>
  <nav class="sidebar print:hidden" aria-label={hasSidebar ? sidebarLabel : t.menu}>
    <button popovertarget="site__sidebar" class="site-menu-button round-button site-flex">
      <Icon name="bars" class="open-menu" />
      <Icon name="close" class="close-menu" />
      <span class="sr-only">{routeLabel(Astro.locals, 'menuButton.accessibleLabel')}</span>
    </button>
    <site-sidebar-pane popover="" id="site__sidebar" class="sidebar-pane">
      <div class="sidebar-content site-flex">
        <SiteMenu />
        <slot name="sidebar" />
      </div>
    </site-sidebar-pane>
  </nav>
  <div class="main-frame"><slot /></div>
</div>

<script>
  class SitePane extends HTMLElement {
    constructor() {
      super();
      const hasSidebar = document.documentElement.hasAttribute('data-has-sidebar');
      const desktop = matchMedia('(min-width: 50em)');
      const reset = () => {
        this.popover = hasSidebar && desktop.matches ? null : 'auto';
      };
      reset();
      desktop.addEventListener('change', reset);
      this.addEventListener('toggle', (e) => {
        const open = (e as ToggleEvent).newState === 'open';
        document.querySelectorAll<HTMLElement>('.main-frame, .site-skip-link').forEach((el) => el.toggleAttribute('inert', open));
      });
    }
  }
  customElements.define('site-sidebar-pane', SitePane);
</script>

<style>
  @layer site.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }
    .header {
      z-index: var(--site-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--header-height);
    }
    .sidebar-pane {
      border: unset;
      padding: unset;
      height: unset;
      color: unset;
      position: fixed;
      z-index: var(--site-z-index-menu);
      inset-block: var(--header-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--color-bg-primary);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }
    .sidebar-content {
      height: 100%;
      min-height: max-content;
      flex-direction: column;
      gap: var(--space-4);
    }
    .main-frame {
      padding-top: calc(var(--header-height) + var(--site-mobile-toc-height));
      padding-inline-start: var(--site-content-inline-start);
    }
    .site-menu-button {
      position: fixed;
      top: calc((var(--header-height) - 44px) / 2);
      inset-inline-end: var(--header-pad-x);
      z-index: var(--site-z-index-navbar);
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .site-menu-button:has(~ :popover-open) .open-menu,
    .site-menu-button:not(:has(~ :popover-open)) .close-menu {
      display: none;
    }
    @media (min-width: 50em) {
      :global([data-has-sidebar]) .sidebar-pane {
        display: block;
        width: var(--site-sidebar-width);
        background-color: var(--color-bg-tertiary);
        border-inline-end: 1px solid var(--color-border);
      }
      :global([data-has-sidebar]) .site-menu-button {
        display: none;
      }
    }
  }
</style>
<style is:global>
  @layer site.core {
    body:has(#site__sidebar:popover-open) {
      overflow: hidden;
    }
  }
</style>
