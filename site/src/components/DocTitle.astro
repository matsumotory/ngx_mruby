---
// Adapted from Starlight 0.42.6; see STARLIGHT-LICENSE.
import { getSiteRoute } from '../route.mjs';
const PAGE_TITLE_ID = '_top';
---

<h1 id={PAGE_TITLE_ID}>{getSiteRoute(Astro.locals).entry.data.title}</h1>

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}
</style>
