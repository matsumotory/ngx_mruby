---
// A sample of docs/proposals/site.md, 3.5 and 3.3 item 8, on the home
// pages: the files that a case of test/t/cases/ compares, copied from the
// test files at build time (scripts/lib/samples.mjs), with the line that
// names the case and the date of the last commit to the files. The build
// stops when a file or the case is missing.
import { Code } from '@astrojs/starlight/components';
import path from 'node:path';
import { loadSample, sampleCaptionHtml, sampleTitle, specFromProps } from '../../scripts/lib/samples.mjs';

interface Props {
  case: string;
  conf: string;
  script: string;
  request?: string;
  response?: string;
  compared?: string;
  label?: 'development';
  lang: 'en' | 'ja';
  presentation?: 'workbench' | 'focused';
}
const props = Astro.props;
const labels = props.lang === 'ja'
  ? { conf: 'nginx.conf', script: 'Rubyハンドラ', request: 'リクエスト', response: '期待する応答', compared: '検証結果（mock）' }
  : { conf: 'nginx.conf', script: 'Ruby handler', request: 'Request', response: 'Expected response', compared: 'Checked output (mock)' };
// The build runs in site/ (npm run build); Astro bundles this component,
// so import.meta.url does not point to src/components/ when it runs.
const repo = path.resolve(process.cwd(), '..');
const spec = specFromProps(props);
const sample = loadSample(spec, repo, `the sample of ${Astro.url.pathname}`);
---

<div class:list={["sample", { "sample-workbench": props.presentation === 'workbench', "sample-focused": props.presentation === 'focused' }]}>
  <div class="sample-files">
  {sample.shown.filter(item => props.presentation !== 'focused' || item.key !== 'conf').map((item, index) => <div class:list={["sample-file", `sample-${item.key}`]}>
    {props.presentation && <div class="sample-file-label"><span title={item.file}>{labels[item.key]}</span><span aria-hidden="true">{item.lang === 'ruby' ? 'RUBY' : item.lang === 'nginx' ? 'NGINX' : item.lang === 'text' ? 'TEST' : 'HTTP'}</span></div>}
    <Code code={item.text.replace(/\n$/, '')} lang={item.lang} title={props.presentation ? undefined : sampleTitle(item, props.lang)} />
  </div>)}
  </div>
  {props.presentation === 'focused' && <details class="sample-config"><summary>{props.lang === 'ja' ? 'nginx.confを開く' : 'Show nginx.conf'}</summary>{sample.shown.filter(item => item.key === 'conf').map(item => <Code code={item.text.replace(/\n$/, '')} lang={item.lang} title={sampleTitle(item, props.lang)} />)}</details>}
  <p class="caption sample-caption" set:html={sampleCaptionHtml(sample, props.lang)} />
</div>
