---
// A sample of docs/proposals/site.md, 3.5 and 3.3 item 8, on the home
// pages: the files that a case of test/t/cases/ compares, copied from the
// test files at build time (scripts/lib/samples.mjs), with the line that
// names the case and the date of the last commit to the files. The build
// stops when a file or the case is missing.
import { Code } from '@astrojs/starlight/components';
import path from 'node:path';
import { loadSample, sampleCaptionHtml, sampleTitle, specFromProps } from '../../scripts/lib/samples.mjs';

interface Props {
  case: string;
  conf: string;
  script: string;
  request: string;
  response: string;
  lang: 'en' | 'ja';
  presentation?: 'workbench';
}
const props = Astro.props;
const labels = props.lang === 'ja'
  ? { conf: 'nginx.conf', script: 'Rubyハンドラ', request: 'リクエスト', response: '期待する応答' }
  : { conf: 'nginx.conf', script: 'Ruby handler', request: 'Request', response: 'Expected response' };
// The build runs in site/ (npm run build); Astro bundles this component,
// so import.meta.url does not point to src/components/ when it runs.
const repo = path.resolve(process.cwd(), '..');
const spec = specFromProps(props);
const sample = loadSample(spec, repo, `the sample of ${Astro.url.pathname}`);
---

<div class:list={["sample", { "sample-workbench": props.presentation === 'workbench' }]}>
  <div class="sample-files">
  {sample.shown.map((item, index) => <div class:list={["sample-file", `sample-${item.key}`]}>
    {props.presentation === 'workbench' && <div class="sample-file-label"><span title={item.file}>{String(index + 1).padStart(2, '0')} / {labels[item.key]}</span><span aria-hidden="true">{item.lang === 'ruby' ? 'RUBY' : item.lang === 'nginx' ? 'NGINX' : 'HTTP'}</span></div>}
    <Code code={item.text.replace(/\n$/, '')} lang={item.lang} title={props.presentation === 'workbench' ? undefined : sampleTitle(item, props.lang)} />
  </div>)}
  </div>
  <p class="caption sample-caption" set:html={sampleCaptionHtml(sample, props.lang)} />
</div>
