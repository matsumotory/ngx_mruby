---
import { getSiteRoute } from '../route.mjs';
// The previous and next links of documentation pages, then the footer of
// every page (4.10): the project and who leads it, three groups of links
// (documentation, the project, the language) and a line of the page's
// metadata (its Markdown, the documents index and the last-updated date).
import fs from 'node:fs';
import { execFileSync } from 'node:child_process';
import path from 'node:path';
import LastUpdated from './LastUpdated.astro';
import Pagination from './Pagination.astro';
import LanguageLink from './LanguageLink.astro';
import { GITHUB_URL, strings, versionLink } from '../site-nav.mjs';
import { BASE, GITHUB_REF, SITE_VERSION, pageOfRoute } from '../../scripts/lib/site.mjs';

const lang = getSiteRoute(Astro.locals).locale === 'ja' ? 'ja' : 'en';
const t = strings(lang);
// The documentation of the other version (3.4): from 3.x to /v2/, from 2.x
// to /docs/, beside the language link.
const version = versionLink(lang);
// The 2.x build (step 6) links to its own Releases and Security pages,
// and to the license on master.
const p = `${BASE}${lang === 'ja' ? '/ja' : ''}`;
// The home pages are committed MDX files: their last-updated date is the
// date of the last commit to them, as git log --format=%cs gives it, which
// is how the generator dates the pages of docs/. Using the commit-local
// date preserves the day during the hours after midnight JST.
const route = getSiteRoute(Astro.locals);
const routePath = Astro.url.pathname.slice(BASE.length).replace(/^\/|\/$/g, '');
const { page: sourcePage, fallback } = pageOfRoute(JSON.parse(fs.readFileSync(path.join(process.cwd(), 'generated/pages.json'), 'utf8')), routePath);
const markdown = sourcePage && !sourcePage.home ? `${BASE}/markdown/${sourcePage.route || 'index'}.md` : null;
if (route.entry.filePath && route.entry.filePath.endsWith('index.mdx')) {
  const file = path.resolve(process.cwd(), route.entry.filePath);
  const date = execFileSync('git', ['log', '-1', '--format=%cs', '--', file], { cwd: process.cwd(), encoding: 'utf8' }).trim();
  if (date) route.lastUpdated = new Date(`${date}T00:00:00Z`);
}
---

<Pagination />
<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-project">
      <p class="footer-wordmark">ngx_mruby</p>
      <p>{lang === 'ja' ? 'nginxの処理をRubyで拡張するモジュールです。' : 'A module that extends nginx with Ruby.'}</p>
      <p>{lang === 'ja' ? <>開発：松本亮介（<a href="https://github.com/matsumotory">matsumotory</a>）</> : <>Led by Ryosuke Matsumoto (<a href="https://github.com/matsumotory">matsumotory</a>)</>}</p>
    </div>
    <nav class="footer-group" aria-labelledby="footer-docs">
      <p class="footer-title" id="footer-docs">{lang === 'ja' ? '文書' : 'Documentation'}</p>
      <ul>
        <li><a class="version-link" href={version.href}>{version.label}</a></li>
        <li><a href={`${p}/releases/`}>{t.releases}</a></li>
        <li><a href={`${p}/security/`}>{t.security}</a></li>
        {SITE_VERSION === 3 && <li><a href={`${p}/glossary/`}>{lang === 'ja' ? '用語集' : 'Glossary'}</a></li>}
      </ul>
    </nav>
    <nav class="footer-group" aria-labelledby="footer-project">
      <p class="footer-title" id="footer-project">{lang === 'ja' ? 'プロジェクト' : 'Project'}</p>
      <ul>
        <li><a href={GITHUB_URL}>GitHub</a></li>
        <li>{lang === 'ja' ? 'ライセンス：' : 'License: '}<a href={`${GITHUB_URL}/blob/${GITHUB_REF}/LICENSE`}>MIT</a></li>
        <li><a href={`${p}/contributing/`}>{t.contributing}</a></li>
      </ul>
    </nav>
    <nav class="footer-group" aria-labelledby="footer-language">
      <p class="footer-title" id="footer-language">{lang === 'ja' ? '言語' : 'Language'}</p>
      <ul>
        <li><LanguageLink /></li>
      </ul>
    </nav>
  </div>
  <div class="meta">
    {markdown && <a class="doc-markdown" href={markdown}>{fallback ? 'Markdown (English)' : 'Markdown'}</a>}
    <a class="doc-index" href={`${BASE}/docs-index.json`}>{lang === 'ja' ? '文書索引のJSON' : 'Docs index JSON'}</a>
    <LastUpdated />
  </div>
</footer>
