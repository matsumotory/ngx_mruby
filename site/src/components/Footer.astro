---
import { getSiteRoute } from '../route.mjs';
// The footer of every page (4.10): the last-updated date and the
// previous and next links of documentation pages, then the site's footer
// with a 1 px top border, 14 px muted text, 48 px above and 32 px below:
// the language link, Releases, Security, the license and GitHub.
import fs from 'node:fs';
import { execFileSync } from 'node:child_process';
import path from 'node:path';
import LastUpdated from './LastUpdated.astro';
import Pagination from './Pagination.astro';
import LanguageLink from './LanguageLink.astro';
import { GITHUB_URL, strings } from '../site-nav.mjs';
import { BASE, GITHUB_REF, pageOfRoute } from '../../scripts/lib/site.mjs';
import { OPENSSF_BADGE } from '../../scripts/lib/project-badges.mjs';

const lang = getSiteRoute(Astro.locals).locale === 'ja' ? 'ja' : 'en';
const t = strings(lang);
// The 2.x build (step 6) links to its own Releases and Security pages,
// and to the license on master.
const p = `${BASE}${lang === 'ja' ? '/ja' : ''}`;
// The home pages are committed MDX files: their last-updated date is the
// date of the last commit to them, as git log --format=%cs gives it, which
// is how the generator dates the pages of docs/. Using the commit-local
// date preserves the day during the hours after midnight JST.
const route = getSiteRoute(Astro.locals);
const routePath = Astro.url.pathname.slice(BASE.length).replace(/^\/|\/$/g, '');
const { page: sourcePage, fallback } = pageOfRoute(JSON.parse(fs.readFileSync(path.join(process.cwd(), 'generated/pages.json'), 'utf8')), routePath);
const markdown = sourcePage && !sourcePage.home ? `${BASE}/markdown/${sourcePage.route || 'index'}.md` : null;
if (route.entry.filePath && route.entry.filePath.endsWith('index.mdx')) {
  const file = path.resolve(process.cwd(), route.entry.filePath);
  const date = execFileSync('git', ['log', '-1', '--format=%cs', '--', file], { cwd: process.cwd(), encoding: 'utf8' }).trim();
  if (date) route.lastUpdated = new Date(`${date}T00:00:00Z`);
}
---

<footer class="site-flex">
  <div class="meta site-flex">
    {markdown && <a class="doc-markdown" href={markdown}>{fallback ? 'Markdown (English)' : 'Markdown'}</a>}
    <a class="doc-index" href={`${BASE}/docs-index.json`}>{lang === 'ja' ? '文書索引 JSON' : 'Docs index JSON'}</a>
    <LastUpdated />
  </div>
  <Pagination />
  <div class="site-footer">
    <ul>
      <li><LanguageLink /></li>
      <li><a href={`${p}/releases/`}>{t.releases}</a></li>
      <li><a href={`${p}/security/`}>{t.security}</a></li>
      <li><a href={`${GITHUB_URL}/blob/${GITHUB_REF}/LICENSE`}>MIT</a></li>
      <li><a href={GITHUB_URL}>GitHub</a></li>
      <li><a class="project-badge" href={OPENSSF_BADGE.href}>
        <img src={OPENSSF_BADGE.src} alt={OPENSSF_BADGE.alt}
          width={OPENSSF_BADGE.width} height={OPENSSF_BADGE.height}
          loading="lazy" decoding="async" referrerpolicy="no-referrer" />
      </a></li>
    </ul>
  </div>
</footer>

<style>
  @layer site.core {
    footer {
      flex-direction: column;
      gap: var(--space-5);
    }
    .meta a {
      color: var(--color-text-muted);
      min-height: 24px;
      display: inline-flex;
      align-items: center;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
    }
    .meta {
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: var(--space-4);
    }
  }
</style>
