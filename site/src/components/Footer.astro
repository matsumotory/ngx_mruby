---
// The footer of every page (4.10): Starlight's last-updated date and the
// previous and next links of documentation pages, then the site's footer
// with a 1 px top border, 14 px muted text, 48 px above and 32 px below:
// the language link, Releases, Security, the license and GitHub.
import { execFileSync } from 'node:child_process';
import path from 'node:path';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import LanguageLink from './LanguageLink.astro';
import { GITHUB_URL, strings } from '../site-nav.mjs';
import { BASE, GITHUB_REF } from '../../scripts/lib/site.mjs';

const lang = Astro.locals.starlightRoute.locale === 'ja' ? 'ja' : 'en';
const t = strings(lang);
// The 2.x build (step 6) links to its own Releases and Security pages,
// and to the license on master.
const p = `${BASE}${lang === 'ja' ? '/ja' : ''}`;
// The home pages are committed MDX files: their last-updated date is the
// date of the last commit to them, as git log --format=%cs gives it, which
// is how the generator dates the pages of docs/ (Starlight's own git date
// is the UTC day, which differs from it in the hours after midnight JST).
const route = Astro.locals.starlightRoute;
if (route.entry.filePath && route.entry.filePath.endsWith('index.mdx')) {
  const file = path.resolve(process.cwd(), route.entry.filePath);
  const date = execFileSync('git', ['log', '-1', '--format=%cs', '--', file], { cwd: process.cwd(), encoding: 'utf8' }).trim();
  if (date) route.lastUpdated = new Date(`${date}T00:00:00Z`);
}
---

<footer class="sl-flex">
  <div class="meta sl-flex">
    <LastUpdated />
  </div>
  <Pagination />
  <div class="site-footer">
    <ul>
      <li><LanguageLink /></li>
      <li><a href={`${p}/releases/`}>{t.releases}</a></li>
      <li><a href={`${p}/security/`}>{t.security}</a></li>
      <li><a href={`${GITHUB_URL}/blob/${GITHUB_REF}/MITL`}>{t.license}</a></li>
      <li><a href={GITHUB_URL}>GitHub</a></li>
    </ul>
  </div>
</footer>

<style>
  @layer starlight.core {
    footer {
      flex-direction: column;
      gap: var(--space-5);
    }
    .meta {
      flex-wrap: wrap;
      justify-content: flex-end;
    }
  }
</style>
