---
import { getSiteRoute } from '../route.mjs';
// The site's items in the menu (4.10, "Narrow screens"): at 640 px and
// below, the language link first under the heading "Language", then the
// section links and GitHub; between 641 px and the width
// where the header holds the section links, the section links alone. On
// pages with a sidebar the menu is the sidebar pane, and these
// items come before the sidebar.
import Icon from './Icon.astro';
import GithubStars from './GithubStars.astro';
import LanguageLink from './LanguageLink.astro';
import { GITHUB_URL, sectionLinks, strings, currentSection } from '../site-nav.mjs';

const lang = getSiteRoute(Astro.locals).locale === 'ja' ? 'ja' : 'en';
const t = strings(lang);
const current = currentSection(lang, Astro.url.pathname);
---

<div class="site-menu">
  <section class="site-menu-language">
    <h2 class="site-menu-heading">{t.language}</h2>
    <LanguageLink class="site-menu-row" />
  </section>
  <section class="site-menu-sections">
    <h2 class="site-menu-heading">{t.sections}</h2>
    <ul>
      {
        sectionLinks(lang).map((link) => (
          <li>
            <a class="site-menu-row" href={link.href} aria-current={link.key === current ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <section class="site-menu-more">
    <ul>
      <li>
        <a class="site-menu-row github-link" href={GITHUB_URL}><Icon name="github" class="github-mark" />GitHub<GithubStars /></a>
      </li>
    </ul>
  </section>
</div>
