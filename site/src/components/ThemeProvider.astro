{/* Apply the saved theme before rendering to avoid FOUC. Keep the existing
    storage key so visitors retain their preference across the migration. */}
<script is:inline>
  (() => {
    const storedTheme =
      typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
    const theme = storedTheme ||
      (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
    document.documentElement.dataset.themeScript = '';
  })();
</script>
