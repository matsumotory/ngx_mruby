<div class="lg:site-flex">
	{
		Astro.locals.siteRoute.toc && (
			<aside class="right-sidebar-container print:hidden">
				<div class="right-sidebar">
					<slot name="right-sidebar" />
				</div>
			</aside>
		)
	}
	<div class="main-pane"><slot /></div>
</div>

<style>
	@layer site.core {
		.main-pane {
			isolation: isolate;
		}

		@media (min-width: 72rem) {
			.right-sidebar-container {
				order: 2;
				position: relative;
				width: max(
					var(--site-sidebar-width),
					calc(
						var(--site-sidebar-width) + (100% - var(--site-content-width) - var(--site-sidebar-width)) / 2
					)
				);
			}

			.right-sidebar {
				position: fixed;
				top: 0;
				border-inline-start: 1px solid var(--color-border);
				padding-top: var(--header-height);
				width: 100%;
				height: 100vh;
				overflow-y: auto;
				scrollbar-width: none;
			}

			.main-pane {
				width: 100%;
			}

			:global([data-has-sidebar][data-has-toc]) .main-pane {
				--site-content-margin-inline: auto 0;

				order: 1;
				width: min(
					calc(100% - var(--site-sidebar-width)),
					calc(
						var(--site-content-width) + (100% - var(--site-content-width) - var(--site-sidebar-width)) / 2
					)
				);
			}
		}
	}
</style>
