---
import Icon from '../components/Icon.astro';
import { t } from './strings.mjs';
// Adapted from Starlight 0.42.6. Copyright Astro contributors. MIT: ./STARLIGHT-LICENSE.

import TableOfContentsList from './TocList.astro';

const { toc } = Astro.locals.siteRoute;
---

{
	toc && (
		<mobile-site-toc data-min-h={toc.minHeadingLevel} data-max-h={toc.maxHeadingLevel}>
			<nav aria-labelledby="site__on-this-page--mobile">
				<details id="site__mobile-toc">
					<summary id="site__on-this-page--mobile" class="site-flex">
						<span class="toggle site-flex">
							{t(Astro.locals.siteRoute.locale, 'tableOfContents.onThisPage')}
							<Icon name={'right-caret'} class="caret" size="1rem" />
						</span>
						<span class="display-current" />
					</summary>
					<div class="dropdown">
						<TableOfContentsList toc={toc.items} isMobile />
					</div>
				</details>
			</nav>
		</mobile-site-toc>
	)
}

<style>
	@layer site.core {
		nav {
			position: fixed;
			z-index: var(--site-z-index-toc);
			top: calc(var(--header-height) - 1px);
			inset-inline: 0;
			border-top: 1px solid var(--color-border);
			background-color: var(--color-bg-tertiary);
		}
		@media (min-width: 50rem) {
			nav {
				inset-inline-start: var(--site-content-inline-start, 0);
			}
		}

		summary {
			gap: 0.5rem;
			align-items: center;
			height: var(--site-mobile-toc-height);
			border-bottom: 1px solid var(--color-border);
			padding: 0.5rem 1rem;
			font-size: var(--text-caption);
			outline-offset: var(--site-outline-offset-inside);
		}
		summary::marker,
		summary::-webkit-details-marker {
			display: none;
		}

		.toggle {
			flex-shrink: 0;
			gap: 1rem;
			align-items: center;
			justify-content: space-between;
			border: 1px solid var(--color-border);
			border-radius: 0.5rem;
			padding-block: 0.5rem;
			padding-inline-start: 0.75rem;
			padding-inline-end: 0.5rem;
			line-height: 1;
			background-color: var(--color-bg-primary);
			user-select: none;
			cursor: pointer;
		}
		details[open] .toggle {
			color: var(--color-text-primary);
			border-color: var(--color-accent);
		}
		details .toggle:hover {
			color: var(--color-text-primary);
			border-color: var(--color-text-primary);
		}

		:global([dir='rtl']) .caret {
			transform: rotateZ(180deg);
		}
		details[open] .caret {
			transform: rotateZ(90deg);
		}

		.display-current {
			white-space: nowrap;
			text-overflow: ellipsis;
			overflow: hidden;
			color: var(--color-text-primary);
		}

		.dropdown {
			--border-top: 1px;
			margin-top: calc(-1 * var(--border-top));
			border: var(--border-top) solid var(--color-bg-tertiary);
			border-top-color: var(--color-border);
			max-height: calc(85vh - var(--header-height) - var(--site-mobile-toc-height));
			overflow-y: auto;
			background-color: var(--color-bg-primary);
			box-shadow: none;
			overscroll-behavior: contain;
		}
	}
</style>

<script>
	import { SiteTOC } from './toc.js';

	class MobileSiteTOC extends SiteTOC {
		override set current(link: HTMLAnchorElement) {
			super.current = link;
			const display = this.querySelector('.display-current') as HTMLSpanElement;
			if (display) display.textContent = link.textContent;
		}

		constructor() {
			super();
			const details = this.querySelector('details');
			if (!details) return;
			const closeToC = () => {
				details.open = false;
			};
			// Close the table of contents whenever a link is clicked.
			details.querySelectorAll('a').forEach((a) => {
				a.addEventListener('click', closeToC);
			});
			// Close the table of contents when a user clicks outside of it.
			window.addEventListener('click', (e) => {
				if (!details.contains(e.target as Node)) closeToC();
			});
			// Or when they press the escape key.
			window.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && details.open) {
					const hasFocus = details.contains(document.activeElement);
					closeToC();
					if (hasFocus) {
						const summary = details.querySelector('summary');
						if (summary) summary.focus();
					}
				}
			});
		}
	}

	customElements.define('mobile-site-toc', MobileSiteTOC);
</script>
