---
import MobileTableOfContents from './MobileTableOfContents.astro';
import TableOfContents from './TableOfContents.astro';
---

{
	Astro.locals.siteRoute.toc && (
		<>
			<div class="lg:site-hidden">
				<MobileTableOfContents />
			</div>
			<div class="right-sidebar-panel site-hidden lg:site-block">
				<div class="site-container">
					<TableOfContents />
				</div>
			</div>
		</>
	)
}

<style>
	@layer site.core {
		.right-sidebar-panel {
			padding: 1rem var(--gutter);
		}
		.site-container {
			width: calc(var(--site-sidebar-width) - 2 * var(--gutter));
		}
		.right-sidebar-panel :global(h2) {
			color: var(--color-text-primary);
			font-size: var(--text-body);
			font-weight: 600;
			line-height: var(--leading-h2);
			margin-bottom: 0.5rem;
		}
		.right-sidebar-panel :global(:where(a)) {
			display: block;
			font-size: var(--text-caption);
			text-decoration: none;
			color: var(--color-text-muted);
			overflow-wrap: anywhere;
		}
		.right-sidebar-panel :global(:where(a):hover) {
			color: var(--color-text-primary);
		}
		@media (min-width: 72rem) {
			.site-container {
				max-width: calc(
					(
						(
								100vw - var(--site-sidebar-width) - 2 * var(--gutter) - 2 *
									var(--gutter)
							) * 0.25 /* MAGIC NUMBER 🥲 */
					)
				);
			}
		}
	}
</style>
