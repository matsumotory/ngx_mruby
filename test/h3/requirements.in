# The Python packages of the HTTP/3 client of the suite
# (test/t/cases/_h3_client.py): aioquic and every package that it needs,
# each at one version. test.sh installs them from requirements.txt, which
# `python3 test/h3/lock.py` writes from this file with the hashes of every
# file that PyPI has for these versions ("HTTP/2 and HTTP/3" in
# docs/test/README.md).
#
# The versions run on Python 3.10 (Ubuntu 22.04, the runner of the build
# job) to 3.14, with wheels for Linux (x86-64 and arm64) and macOS. aioquic
# 1.3.0 is the newest release with wheels for Python 3.10 that is older
# than the seven days that Dependabot waits for a release
# (.github/dependabot.yml): 1.4.0 to 1.9.0 require Python 3.11.
aioquic==1.3.0
attrs==26.1.0
certifi==2026.10.23
cffi==2.1.1 ; platform_python_implementation != "PyPy"
cryptography==50.0.2
pycparser==3.11 ; implementation_name != "PyPy"
pylsqpack==0.3.24
pyopenssl==26.4.0
service-identity==26.1.0
typing-extensions==4.16.0 ; python_version < "3.13"
